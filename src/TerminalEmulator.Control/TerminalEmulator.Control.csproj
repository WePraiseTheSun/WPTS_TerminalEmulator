<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>TerminalEmulator.Control</RootNamespace>
    <AssemblyName>TerminalEmulator.Control</AssemblyName>
    <Description>WinForms terminal emulator UserControl: WebView2 + xterm.js frontend over a native ConPTY backend.</Description>
    <Version>1.1.0</Version>
    <Platforms>AnyCPU;x64</Platforms>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Renderer assets served through the WebView2 virtual host mapping.
         They must sit next to the DLL at runtime; Content items flow to
         referencing projects automatically. -->
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
